NODE_ENV=production
# Writable HOME for pnpm/tsx caches inside the read-only app containers.
HOME=/tmp
IMAGE_TAG=latest

# The API publishes a single port. Nginx (operator-managed) reverse-proxies the
# whole site (dashboard SPA, /api, /ws) to this port with your own domain/TLS.
API_PUBLISH_PORT=8080

# --- Database (project REQUIRES PostgreSQL) ---
POSTGRES_DB=arbitrage_scanner
POSTGRES_USER=arbitrage
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Publish Postgres on the host only if you need external access (e.g. 5433 to avoid clashes).
# Leave empty to keep Postgres internal-only (recommended).
POSTGRES_PUBLISH_PORT=

# --- Redis (compose-managed; host port defaults to 6380 to avoid clashing with 6379) ---
REDIS_PUBLISH_PORT=6380

# Production API must not run mock data.
MOCK_FEED=0

# --- Solana RPC (Helius) for collector network-state collection ---
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/
SOLANA_RPC_API_KEY=

# --- Scanner fee assumptions and capital limits ---
FUNDING_SCAN_MAX_CAPITAL_USD=25000
BASIS_SCAN_MAX_CAPITAL_USD=25000
BINANCE_SPOT_TAKER_FEE=0.001
BYBIT_SPOT_TAKER_FEE=0.001
BINANCE_FUTURES_TAKER_FEE=0.0005
BYBIT_LINEAR_TAKER_FEE=0.00055
HYPERLIQUID_TAKER_FEE=0.00045
JUPITER_TAKER_FEE=0.00085
RAYDIUM_TAKER_FEE=0.0025

# Phase 1 is read-only. Do not add private keys or exchange trading credentials.
JUPITER_API_KEY=
JUPITER_QUOTE_URL=https://api.jup.ag/swap/v1/quote
JUPITER_SLIPPAGE_BPS=50
RAYDIUM_QUOTE_URL=https://transaction-v1.raydium.io/compute/swap-base-in
RAYDIUM_POOL_INFO_URL=https://api-v3.raydium.io/pools/info/ids
RAYDIUM_SLIPPAGE_BPS=50
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Dashboard served from the same API origin; WS URL is derived from location.host.
# Leave VITE_WS_URL empty. Set it only when the dashboard is hosted elsewhere.
VITE_WS_URL=
