{
  "name": "arbitrage-scanner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "collector:binance": "pnpm --filter @arbitrage-scanner/collector binance",
    "collector:bybit": "pnpm --filter @arbitrage-scanner/collector bybit",
    "collector:hyperliquid": "pnpm --filter @arbitrage-scanner/collector hyperliquid",
    "db:migrate": "pnpm --filter @arbitrage-scanner/database migrate",
    "scan:cex": "pnpm --filter @arbitrage-scanner/scanner cex",
    "scan:funding": "pnpm --filter @arbitrage-scanner/scanner funding",
    "scan:basis": "pnpm --filter @arbitrage-scanner/scanner basis",
    "scan:cex-dex": "pnpm --filter @arbitrage-scanner/scanner cex-dex",
    "scan:dex-dex": "pnpm --filter @arbitrage-scanner/scanner dex-dex",
    "scan:polymarket": "pnpm --filter @arbitrage-scanner/scanner polymarket",
    "api:dev": "pnpm --filter @arbitrage-scanner/api dev",
    "dashboard:dev": "pnpm --filter @arbitrage-scanner/dashboard dev",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^10.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
