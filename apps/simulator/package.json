{
  "name": "@arbitrage-scanner/simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "start:prod": "tsx --env-file-if-exists=../../.env src/production.ts",
    "replay": "tsx --env-file-if-exists=../../.env src/run-replay.ts",
    "replay:synthetic": "SYNTHETIC=1 tsx --env-file-if-exists=../../.env src/run-replay.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "@arbitrage-scanner/core": "workspace:*",
    "@arbitrage-scanner/database": "workspace:*",
    "@arbitrage-scanner/execution": "workspace:*",
    "@arbitrage-scanner/risk": "workspace:*",
    "@arbitrage-scanner/strategies": "workspace:*",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.20.0"
  }
}
